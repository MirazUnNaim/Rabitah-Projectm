<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.rabitah.frontend.controller.ShellController" styleClass="page">
 <top>
  <HBox spacing="14" styleClass="topbar">
   <Label text="Rabitah" styleClass="brand-small"/>
   <Label text="YOUR CAMPUS SPACE" styleClass="build-label"/>
   <Region HBox.hgrow="ALWAYS"/>
   <Label fx:id="serverLabel" styleClass="status-pill"/>
   <Label fx:id="welcome" styleClass="field-label"/>
   <Button text="Log out" onAction="#logout" styleClass="secondary-button"/>
  </HBox>
 </top>
 <center>
  <TabPane fx:id="mainTabs" tabClosingPolicy="UNAVAILABLE" styleClass="platform-tabs">
   <tabs>
    <Tab text="Social Feed">
     <BorderPane styleClass="social-feed">
      <top>
       <VBox spacing="7" styleClass="social-feed-top">
        <HBox spacing="10" styleClass="compact-composer">
         <Label fx:id="feedAvatar" styleClass="feed-avatar"/>
         <Button fx:id="openPostComposer" text="What's on your mind?" onAction="#openPostComposer" HBox.hgrow="ALWAYS" styleClass="composer-prompt"/>
         <Button text="Photo / video" onAction="#openPostComposerWithMedia" styleClass="composer-media-button"/>
        </HBox>
        <HBox spacing="8" styleClass="feed-status-row">
         <Label fx:id="feedStatus" text="Loading posts…" styleClass="muted"/>
         <Region HBox.hgrow="ALWAYS"/>
         <Button text="Refresh" onAction="#refreshFeed" styleClass="feed-refresh-button"/>
        </HBox>
       </VBox>
      </top>
      <center>
       <ScrollPane fx:id="feedScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="feed-scroll">
        <content><VBox fx:id="feedContainer" spacing="12" styleClass="feed-container"/></content>
       </ScrollPane>
      </center>
     </BorderPane>
    </Tab>
    <Tab text="Notice Board">
     <BorderPane>
      <top>
       <VBox spacing="8" styleClass="toolbar">
        <VBox fx:id="noticeComposer" spacing="8" styleClass="feed-composer">
         <HBox spacing="8"><Label text="Publish an official notice" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="noticeType" prefWidth="145"/><Button fx:id="publishNoticeButton" text="Publish notice" onAction="#publishNotice"/></HBox>
         <TextField fx:id="noticeTitle" promptText="Clear, useful notice title" HBox.hgrow="ALWAYS"/>
         <TextArea fx:id="noticeBody" promptText="Write the details students need…" prefRowCount="2"/>
        </VBox>
        <HBox spacing="8"><Label text="Campus announcements" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh notices" onAction="#refreshNotices" styleClass="secondary-button"/></HBox>
       </VBox>
      </top>
      <center><ListView fx:id="noticeList"/></center>
     </BorderPane>
    </Tab>
    <Tab text="Question Repository">
     <BorderPane>
      <top>
       <VBox spacing="8" styleClass="toolbar">
        <VBox spacing="8" styleClass="feed-composer">
         <HBox spacing="8"><Label text="Question papers" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="uploadPaperButton" text="Upload PDF" onAction="#uploadPaper"/></HBox>
         <HBox spacing="8"><ComboBox fx:id="courseBox" promptText="Select course" prefWidth="290"/><TextField fx:id="paperTitle" promptText="Paper title" HBox.hgrow="ALWAYS"/><TextField fx:id="examYear" promptText="Year" prefWidth="100"/></HBox>
        </VBox>
        <HBox spacing="8"><TextField fx:id="paperSearch" promptText="Search by course, code, or title" HBox.hgrow="ALWAYS"/><Button text="Search" onAction="#refreshPapers"/><Button text="Download selected" onAction="#downloadPaper" styleClass="secondary-button"/></HBox>
        <Label fx:id="paperStatus" styleClass="muted"/>
       </VBox>
      </top>
      <center><ListView fx:id="paperList"/></center>
     </BorderPane>
    </Tab>
    <Tab text="Private Chat">
     <BorderPane>
      <left>
       <VBox prefWidth="305" spacing="10" styleClass="chat-sidebar">
        <Label text="Chats" styleClass="section-title"/>
        <TextField fx:id="chatSearch" promptText="Search Messenger" onKeyReleased="#searchChatUsers"/>
        <Label text="People" styleClass="field-label"/>
        <ListView fx:id="chatUserList" prefHeight="150" VBox.vgrow="NEVER"/>
        <Label text="Recent conversations" styleClass="field-label"/>
        <ListView fx:id="conversationList" VBox.vgrow="ALWAYS"/>
       </VBox>
      </left>
      <center>
       <BorderPane>
        <top><HBox spacing="10" styleClass="chat-header"><Label fx:id="chatWith" text="Select someone to start chatting" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="chatStatus" text="" styleClass="muted"/></HBox></top>
        <center><ListView fx:id="messageList"/></center>
        <bottom><VBox spacing="5" styleClass="message-input"><Label fx:id="chatAttachmentStatus" styleClass="muted"/><HBox spacing="8"><Button text="＋" onAction="#chooseChatAttachment" styleClass="secondary-button"/><TextField fx:id="messageText" promptText="Write a message…" onAction="#sendMessage" HBox.hgrow="ALWAYS"/><Button text="Send" onAction="#sendMessage"/></HBox></VBox></bottom>
       </BorderPane>
      </center>
      <right><VBox prefWidth="205" spacing="12" styleClass="chat-sidebar"><Label text="Conversation details" styleClass="section-title"/><Label text="Select a chat to see shared media and actions." wrapText="true" styleClass="muted"/><Button text="View profile" styleClass="secondary-button"/><Button text="Search messages" styleClass="secondary-button"/><Separator/><Label text="Shared files" styleClass="field-label"/></VBox></right>
     </BorderPane>
    </Tab>
    <Tab text="Community">
     <BorderPane>
      <top><VBox spacing="8" styleClass="toolbar"><HBox spacing="8"><Label fx:id="communityName" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refreshCommunity" styleClass="secondary-button"/></HBox><Label text="A focused home for your class community—announcements, questions, and shared momentum." styleClass="muted"/></VBox></top>
      <center><ListView fx:id="communityList"/></center>
      <bottom><HBox fx:id="communityComposer" spacing="8" styleClass="message-input"><TextField fx:id="communityText" promptText="Share a community update…" onAction="#sendCommunityMessage" HBox.hgrow="ALWAYS"/><Button text="Publish" onAction="#sendCommunityMessage"/></HBox></bottom>
     </BorderPane>
    </Tab>
    <Tab fx:id="approvalsTab" text="Admin Approvals">
     <ScrollPane fitToWidth="true"><content><VBox spacing="10" styleClass="toolbar"><HBox spacing="8"><Label text="Approval inbox" styleClass="section-title"/><Label fx:id="approvalSummary" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refreshApprovals"/></HBox><TextField fx:id="decisionReason" promptText="Optional decision note"/><TitledPane text="Student access requests" expanded="true"><content><VBox spacing="6"><ListView fx:id="userApprovalList" prefHeight="150"/><HBox spacing="8"><Button text="Approve" onAction="#approveUser"/><Button text="Decline" onAction="#rejectUser" styleClass="danger-button"/></HBox></VBox></content></TitledPane><TitledPane text="Pending posts" expanded="true"><content><VBox spacing="6"><ListView fx:id="postApprovalList" prefHeight="150"/><HBox spacing="8"><Button text="Approve" onAction="#approvePost"/><Button text="Decline" onAction="#rejectPost" styleClass="danger-button"/></HBox></VBox></content></TitledPane><TitledPane text="Pending question papers" expanded="true"><content><VBox spacing="6"><ListView fx:id="paperApprovalList" prefHeight="150"/><HBox spacing="8"><Button text="Approve" onAction="#approvePaper"/><Button text="Decline" onAction="#rejectPaper" styleClass="danger-button"/></HBox></VBox></content></TitledPane></VBox></content></ScrollPane>
    </Tab>
    <Tab text="My Profile">
     <StackPane><VBox spacing="18" styleClass="content-card"><HBox spacing="16"><StackPane><Label fx:id="profileInitial" styleClass="avatar"/><ImageView fx:id="profileImage" fitHeight="58" fitWidth="58" preserveRatio="true"/></StackPane><VBox spacing="4"><Label fx:id="profileName" styleClass="section-title"/><Label text="Your campus identity" styleClass="muted"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Update photo" onAction="#chooseProfilePhoto" styleClass="secondary-button"/></HBox><Separator/><Label fx:id="profileDetails" wrapText="true" style="-fx-font-size:15px;"/><Label fx:id="profilePhotoStatus" styleClass="muted"/></VBox></StackPane>
    </Tab>
   </tabs>
  </TabPane>
 </center>
</BorderPane>
